# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=ваш_токен_бота

# Токен Crypto Pay app:
#  - основной кошелёк: @CryptoBot -> Crypto Pay -> создать приложение
#  - тест: @CryptoTestNetBot -> Crypto Pay -> создать приложение
CRYPTOPAY_TOKEN=ваш_токен_crypto_pay

# Костыль обхода DPI (замедляющие сети, домашний ПК в РФ): короткие соединения.
# На VPS/сервере НЕ нужен — оставьте закомментированным.
# DPI_WORKAROUND=1

# Администраторы бота (user_id через запятую). Имеют доступ к /stats.
# ADMIN_USER_IDS=

# Защита от спама (по желанию, значения по умолчанию указаны):
# COMMAND_COOLDOWN=2      # сек между командами
# CALLBACK_COOLDOWN=2     # сек между нажатиями кнопок
# MAX_PENDING_PER_USER=1  # максимум активных счетов на пользователя

# Таймаут long polling (сек). На ПК с обходом DPI бот ставит 0 автоматически.
# LONG_POLLING_TIMEOUT=20
